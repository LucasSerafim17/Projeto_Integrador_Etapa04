# 1 = cria três usuários de teste se ainda não existirem. NÃO use em produção.
APP_MODO_DEMO=1

# SQLite local (padrão da demonstração):
DATABASE_URL=sqlite:///./dados_supervisorio.db

# MySQL (substituir após criar o banco e o usuário):
# DATABASE_URL=mysql+pymysql://usuario:senha@127.0.0.1:3306/supervisorio

# Integração CloudWatch opcional; não será ativada sem as configurações AWS.
CLOUDWATCH_ATIVO=0
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=/senai/supervisorio
CLOUDWATCH_LOG_STREAM=aplicacao-local

# Para criar o primeiro admin com APP_MODO_DEMO=0, defina ambos (senha >=12 caracteres):
# ADMIN_INICIAL_USUARIO=administrador
# ADMIN_INICIAL_SENHA=troque-por-uma-senha-forte
